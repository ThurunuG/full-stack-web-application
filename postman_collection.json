{
  "info": {
    "_postman_id": "9b642e0e-3b2d-4c38-8c1d-87265538e123",
    "name": "Full-Stack Web App - REST API Collection",
    "description": "Postman collection covering all endpoints for JWT Auth, RBAC, Customer Form Submissions, and Admin Dashboard CRUD/Filtering/Search.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "submissionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"password\": \"Customer@123\",\n  \"confirmPassword\": \"Customer@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('customerToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Customer@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/customer/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "customer", "login"]
            }
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@evotec.software\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"<insert_refresh_token_here>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer Submissions",
      "item": [
        {
          "name": "Create Submission",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.submission && jsonData.submission.id) {",
                  "    pm.collectionVariables.set('submissionId', jsonData.submission.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Connor\",\n  \"email\": \"sarah.connor@example.com\",\n  \"gender\": \"FEMALE\",\n  \"mobileNumber\": \"+1 555-901-4433\",\n  \"address\": \"420 Cyberdyne Blvd, Los Angeles, CA\",\n  \"feedback\": \"Smooth application experience!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["submissions"]
            }
          }
        },
        {
          "name": "Get My Submissions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions/my",
              "host": ["{{baseUrl}}"],
              "path": ["submissions", "my"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Create New Admin (Auto Password)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newadmin@evotec.software\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/create",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "create"]
            }
          }
        },
        {
          "name": "Get All Admins List",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/list",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "list"]
            }
          }
        },
        {
          "name": "Get All Submissions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["submissions"]
            }
          }
        },
        {
          "name": "Filter Submissions by Gender (MALE)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions?gender=MALE",
              "host": ["{{baseUrl}}"],
              "path": ["submissions"],
              "query": [{ "key": "gender", "value": "MALE" }]
            }
          }
        },
        {
          "name": "Search Submissions by Name",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions?search=Alice",
              "host": ["{{baseUrl}}"],
              "path": ["submissions"],
              "query": [{ "key": "search", "value": "Alice" }]
            }
          }
        },
        {
          "name": "Update Submission",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice (Modified)\",\n  \"address\": \"742 Evergreen Terrace (Renovated)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submissions/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["submissions", "{{submissionId}}"]
            }
          }
        },
        {
          "name": "Delete Submission",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/submissions/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["submissions", "{{submissionId}}"]
            }
          }
        }
      ]
    }
  ]
}
